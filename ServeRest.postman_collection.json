    {
      "name": "Geração de Massa",
      "item": [
        {
          "name": "Busca nova pessoa",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"Validar Status code com 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "const nome = response.results[0].name.first;\r",
                  "\r",
                  "pm.globals.set(\"userName\", pm.response.json().results[0].name.first)\r",
                  "pm.globals.set(\"userEmail\", pm.response.json().results[0].email)\r",
                  "pm.globals.set(\"userPassword\", pm.response.json().results[0].login.userPassword)\r",
                  "\r",
                  "pm.test(\"Validar existência do nome\", function () {\r",
                  "    pm.expect(nome).to.be.a(\"string\");\r",
                  "    pm.expect(nome).to.not.be.empty;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
